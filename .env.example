# =====================================================
#  어떤 모델이 게임에 참여할지
# =====================================================

# 기본 프로바이더 : ollama (로컬) 또는 anthropic (클라우드)
LLM_PROVIDER=ollama

# --- 로컬 (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
# 모델을 VRAM 에 붙잡아 두는 시간. 매 턴 다시 올리면 몇 초씩 날아간다.
OLLAMA_KEEP_ALIVE=30m

# --- 클라우드 (Anthropic) ---
# LLM_PROVIDER 나 LLM_PROVIDER_* 중 하나라도 anthropic 일 때만 필요하다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# --- 역할별 덮어쓰기 (선택) ---
# 역할은 JUDGE(심판) / INSPECT(검수) / GENERATE(단어 생성) / TOPICS(주제 추천).
# 판정은 로컬로 빠르게, 단어 생성만 클라우드로 — 같은 조합을 만들 수 있다.
# LLM_PROVIDER_GENERATE=anthropic
# MODEL_GENERATE=claude-opus-5
# MODEL_JUDGE=qwen3:4b

# =====================================================
#  서버
# =====================================================
PORT=3000

# AI 단어가 검수를 통과한 뒤 심판까지 한 번 더 거칠지 (false 로 두면 AI 차례가 빨라진다)
REFEREE_ON_AI=true
